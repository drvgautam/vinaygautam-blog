---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import { SITE, SOCIALS } from "@consts"
import { isListedBlogPost, readingTime } from "@lib/utils"
import ViewCount from "@components/ViewCount"

const latestPosts = (await getCollection("blog"))
  .filter(isListedBlogPost)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5)

const linkedIn = SOCIALS.find((s) => s.NAME === "LinkedIn")?.HREF ?? "https://www.linkedin.com/in/vinaygautam/"
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-[720px] px-4 sm:px-6 pb-20">

      {/* Hero */}
      <section class="pt-10 sm:pt-14 pb-14 sm:pb-16">
        <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 mb-3">
          Hi, I'm Vinay.
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-[2.75rem] font-bold tracking-tight text-black dark:text-white leading-[1.15] mb-5">
          I build software that connects data, knowledge, and AI.
        </h1>
        <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
          I'm a scientist and software engineer with a background in computational modelling and research software. My current work centres on applied AI engineering, particularly designing systems that use semantic models, ontologies, and knowledge graphs to bring domain context into AI applications.
        </p>
      </section>

      {/* Latest posts */}
      <section class="pb-14 sm:pb-16">
        <div class="flex items-baseline justify-between gap-4 mb-5">
          <h2 class="text-xl sm:text-2xl font-bold text-black dark:text-white">Latest posts</h2>
          <a
            href="/blog"
            class="text-sm font-medium text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 whitespace-nowrap"
          >
            Browse the blog →
          </a>
        </div>
        {latestPosts.length > 0 ? (
          <div class="flex flex-col gap-4">
            {latestPosts.map((post) => (
              <a
                href={`/${post.collection}/${post.slug}`}
                class="group block rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50/80 dark:bg-gray-900/50 p-5 sm:p-6 hover:border-gray-300 dark:hover:border-gray-700 transition-colors"
              >
                <div class="flex gap-4 items-start">
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                      <span class="inline-block text-[11px] font-medium px-2 py-0.5 rounded bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300">
                        {post.data.seriesTitle === "How LLMs work" ? "LLMs, explained" : (post.data.tags?.[0] ?? "Blog")}
                      </span>
                      <span class="text-xs text-gray-500 dark:text-gray-400">
                        {post.data.date.toLocaleDateString("en-GB", {
                          day: "numeric",
                          month: "long",
                          year: "numeric",
                        })}
                      </span>
                      <ViewCount
                        client:load
                        slug={post.slug}
                        class="text-xs text-gray-500 dark:text-gray-400"
                      />
                      <span class="inline-flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <svg class="size-3.5 stroke-current" aria-hidden="true">
                          <use href="/ui.svg#book-open" />
                        </svg>
                        {readingTime(post.body)}
                      </span>
                    </div>
                    <h3 class="text-lg sm:text-xl font-bold text-black dark:text-white mb-2 group-hover:underline underline-offset-2">
                      {post.data.title}
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
                      {post.data.summary}
                    </p>
                    <span class="text-sm font-medium text-purple-600 dark:text-purple-400">
                      View on the blog →
                    </span>
                  </div>
                  <span
                    class="hidden sm:flex shrink-0 size-10 rounded-full border border-gray-200 dark:border-gray-700 items-center justify-center text-gray-400 group-hover:border-purple-300 group-hover:text-purple-500 transition-colors"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500">No posts yet.</p>
        )}
      </section>

      {/* Background / work summary */}
      <section class="pb-4">
        <h2 class="text-xl sm:text-2xl font-bold text-black dark:text-white mb-4">A little background</h2>
        <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed mb-3">
          I spent several years at <strong class="font-semibold text-black dark:text-white">NTNU</strong> and <strong class="font-semibold text-black dark:text-white">Aalto University</strong>, developing research software, data systems, and modelling tools. I hold a PhD in Computer Science from NTNU and also run <strong class="font-semibold text-black dark:text-white">DatumInt</strong>, a consulting practice focused on applied AI and data systems.
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
          PhD in Computer Science · NTNU, 2017
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a
            href="mailto:vkg.biet@gmail.com?subject=CV%20request"
            class="text-sm font-medium text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300"
          >
            Request my CV ↗
          </a>
          <a
            href={linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300"
          >
            Professional profile ↗
          </a>
          <a
            href="https://nva.sikt.no/filter?contributor=307937"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300"
          >
            Publications ↗
          </a>
        </div>
      </section>

    </div>
  </div>
</PageLayout>
